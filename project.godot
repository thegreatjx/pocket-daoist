; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since you can save, make sure to follow the format.

config_version=5

[application]

config/name="百宝小道修 · Pocket Daoist"
config/description="修仙肉鸽割草游戏"
config/version="0.1.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

; 顺序有依赖：Settings 必须先于 Music（Music 读取音乐音量设置），
; GameFlow 必须先于场景脚本（各界面调用它变更流程状态）。
; project.godot 只认 ";" 作为注释符，用 "#" 会被当成语法错误并破坏本段解析。
CombatGrid="*res://scripts/autoload/combat_grid.gd"
ObjectPools="*res://scripts/autoload/object_pools.gd"
Settings="*res://scripts/autoload/settings.gd"
Stats="*res://scripts/autoload/stats.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Music="*res://scripts/autoload/music.gd"
GameFlow="*res://scripts/autoload/game_flow.gd"
HitFeel="*res://scripts/autoload/hit_feel.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/ui_font.tres"

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/canvas_textures/texture_repeat=1
renderer/rendering_method="gl_compatibility"
